# Copy to .env and fill in. Never commit real secrets — .env is gitignored.

# --- Application ---
NODE_ENV=development                 # development | staging | production
LOG_LEVEL=debug

# --- Ports ---
API_PORT=4000
MOCK_RUNTIME_PORT=4001
WEB_PORT=3000

# --- Datastores ---
MONGO_URI=mongodb://localhost:27017/instantmockapi
REDIS_URL=redis://localhost:6379

# Only needed on machines whose Node DNS resolver cannot do mongodb+srv:// SRV
# lookups. Leave UNSET in deployed environments.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Cache / Redis budget ---
# Whether cache traffic may use Redis at all. Unset resolves to: enabled in
# staging/production; in development, enabled ONLY if REDIS_URL is set. False
# runs the cache in-process (L1 only) — every consumer works unchanged.
# The generation queue always needs Redis and ignores this flag.
REDIS_ENABLED=true

# In-process L1 cache — tier 1, checked before Redis. Bounded by BOTH entry
# count and total bytes, since cached configs and seed sets are user-sized.
CACHE_L1_MAX_ENTRIES=500
CACHE_L1_MAX_BYTES=16777216          # 16MB
CACHE_L1_TTL_SECONDS=60              # default cap on how long L1 serves without re-checking Redis

# Hosted-config cache. The key embeds version + generatedAt, so a regenerate
# produces a new key rather than a stale value — long TTLs are safe.
CACHE_CONFIG_TTL_SECONDS=3600

# Mock seed records. The key is stamped the same way, so the Redis TTL can be
# long. CACHE_SEED_L1_TTL_SECONDS is what bounds how long one replica may serve
# a value another replica has since rewritten:
#   5   — safe for multi-replica mock runtimes
#   900 — recommended for single-replica (free tier); removes most seed reads
CACHE_SEED_TTL_SECONDS=900
CACHE_SEED_L1_TTL_SECONDS=5

# --- Generation queue (BullMQ) ---
# Idle polling — not cache traffic — is what drains a free Redis plan. At the
# BullMQ defaults (5s / 30s) one idle worker costs ~605K commands/month, more
# than the 500K free tier, before serving a single request.
# Raising drainDelay does NOT delay job pickup: Queue.add wakes the blocked read
# immediately, so this is only the timeout on an otherwise-idle wait.
QUEUE_DRAIN_DELAY_SECONDS=60
# Trade-off: a job orphaned by a hard worker crash is recovered after up to this
# long instead of 30s. Recovery path only — retries and idempotency still apply.
QUEUE_STALLED_INTERVAL_MS=300000

# --- Worker placement ---
# Run the generator DAG inside the API process (single-service free-tier
# deployments). Set on EXACTLY ONE service: each running worker pays its own
# idle-polling bill against the same Redis plan.
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=1

# --- Object storage (S3-compatible / MinIO) ---
STORAGE_DRIVER=mongo                 # mongo (GridFS) | s3
STORAGE_MONGO_BUCKET=artifacts
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=instantmockapi-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600

# --- Rate limiting (both in-process; neither uses Redis) ---
RATE_LIMIT_PER_MINUTE=100
MOCK_RATE_LIMIT_PER_MINUTE=200

# --- IPS / mock generation ---
MAX_NESTING_DEPTH=10
DEFAULT_MOCK_RECORDS=25
MAX_MOCK_RECORDS=1000
MAX_REQUEST_BODY_SIZE=1048576
MAX_PAGINATION_LIMIT=100

# --- Hosted mock runtime ---
# Public base URL of the mock runtime (…/p). Hosted URLs are ${HOSTED_BASE_URL}/${projectId}.
HOSTED_BASE_URL=https://api.instantmockapi.dev/p

# --- Web app (read by apps/web at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- CORS (read by apps/api) ---
WEB_ORIGIN=http://localhost:3000
